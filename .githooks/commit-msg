#!/bin/sh
set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

MSG_FILE="$1"
export PYTHONIOENCODING=utf-8

PYTHON_BIN=""
for candidate in \
  ".venv/Scripts/python.exe" \
  ".venv/bin/python" \
  "python3" \
  "python" \
  "py"
do
  if "$candidate" scripts/sage_linter.py --help >/dev/null 2>&1; then
    PYTHON_BIN="$candidate"
    break
  fi
done

if [ -z "$PYTHON_BIN" ]; then
  echo "SAGE commit-msg: Python not found; cannot run sage_linter.py" >&2
  exit 2
fi

"$PYTHON_BIN" scripts/sage_linter.py --check-commit-msg "$MSG_FILE"
